---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  /** URL slug, e.g. "devops". */
  slug: string;
  /** Display label, e.g. "DevOps". */
  name: string;
  size?: "sm" | "lg";
};

const { slug, name, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `topics/${slug}/`)}
    transition:name={`topic-${slug}`}
    class:list={[
      "app-link focus-visible:text-accent inline-flex items-center gap-0.5 font-mono",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {name}
  </a>
</li>
