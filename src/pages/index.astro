---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import headshot from "@/assets/images/kmanojkumar-headshot.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import StructuredData from "@/components/StructuredData.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

const siteUrl = config.site.url.replace(/\/+$/, "");
---

<Layout>
  <Fragment slot="head">
    <StructuredData
      type="WebSite"
      data={{
        url: siteUrl + "/",
        searchUrlTemplate: `${siteUrl}/search?q={search_term_string}`,
      }}
    />
  </Fragment>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section
      id="hero"
      class="flex flex-col gap-6 pt-12 pb-6 sm:flex-row sm:items-start sm:gap-8"
    >
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        aria-label="About Manoj Kumar"
        class="shrink-0"
      >
        <Image
          src={headshot}
          alt="K Manoj Kumar"
          widths={[128, 192, 256, 384]}
          sizes="(min-width: 640px) 192px, 128px"
          class="size-32 rounded-md object-cover grayscale sm:size-48"
          loading="eager"
        />
      </a>
      <div class="min-w-0 flex-1">
        <h1 class="app-hero mb-4 inline-block sm:mb-6">
          Hey, I'm <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="app-link"
            title="Manoj Kumar"
            aria-label="About Manoj Kumar"
          >
            MK
          </a>
        </h1>
        <p>
          CS Engineer & Entrepreneur based in Bengaluru 🇮🇳. I share insights on
          DevOps for businesses, Process Automation, and my Startup journey
          building <LinkButton
            class="app-link"
            href="https://vegastack.com"
            rel="noopener"
            target="_blank">VegaStack</LinkButton
          >.
        </p>
        <p class="mt-2">
          Read the posts below, or learn more <LinkButton
            class="app-link"
            href={getRelativeLocaleUrl(locale, "about")}>about me</LinkButton
          >.
        </p>
        {
          socials.length > 0 && (
            <div class="mt-4">
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured">
          <header class="app-section-header">
            <h2 class="app-h2">{t.home.featured}</h2>
          </header>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts">
          <header class="app-section-header">
            <h2 class="app-h2">{t.home.recentPosts}</h2>
          </header>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 flex items-center justify-between gap-4">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href={getRelativeLocaleUrl(locale, "topics")}>
        Topics
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
