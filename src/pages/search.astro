---
import { getRelativeLocaleUrl } from "astro:i18n";
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `search` feature is not enabled
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const backUrl = config.features.showBackButton
  ? `${Astro.url.pathname}`
  : getRelativeLocaleUrl(locale, "");

const pagefindBundlePath = getAssetPath("pagefind/");

const t = useTranslations(locale);
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.searchTitle}>
    <div
      id="pagefind-search"
      transition:persist
      data-backurl={backUrl}
      data-bundle-path={pagefindBundlePath}
    >
    </div>
  </Main>

  <Footer />
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;

    const bundlePath = pageFindSearch?.dataset?.bundlePath;
    if (!bundlePath) return;

    const params = new URLSearchParams(window.location.search);

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Display warning inn dev mode
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="bg-muted/75 rounded p-4 space-y-4 mb-4">
              <p><strong>DEV mode Warning! </strong>You need to build the project at least once to see the search results during development.</p>
              <code class="block bg-black text-white px-2 py-1 rounded">pnpm run build</code>
            </div>
          `;
      }

      // Init pagefind ui
      const search = new PagefindUI({
        element: "#pagefind-search",
        bundlePath,
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          params.set("q", term); // Update the `q` parameter in the URL
          history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading

          const backUrl =
            pageFindSearch?.dataset?.backurl ?? window.location.pathname;
          sessionStorage.setItem("backUrl", `${backUrl}?${params.toString()}`);

          return term;
        },
      });

      // Strict-match filter: hide results where the user's full query isn't
      // present as a (case-insensitive) substring of any <mark> highlight.
      // Pagefind v1.5 has aggressive prefix expansion + a fuzzy fallback —
      // queries like "clickup", "addEventListener", "xyzqwerty" otherwise
      // surface posts that don't actually contain the query.
      //
      // We re-run on every PagefindUI re-render (typing, "show more", etc.)
      // via MutationObserver, then patch the result-count message to match
      // what's actually visible. Observer is disconnected during our own
      // DOM writes to avoid re-trigger loops.
      const inputEl = document.querySelector<HTMLInputElement>(
        ".pagefind-ui__search-input"
      );

      let scheduled = false;
      function scheduleFilter() {
        if (scheduled) return;
        scheduled = true;
        // requestAnimationFrame coalesces bursty mutations from a single
        // pagefind render pass into one filter run per frame.
        requestAnimationFrame(() => {
          scheduled = false;
          applyStrictFilter();
        });
      }

      function applyStrictFilter() {
        filterObserver.disconnect();
        try {
          const rawQuery = (inputEl?.value ?? "").trim();
          if (!rawQuery) return; // empty input: leave pagefind UI alone

          // Tokenize: split on any non-letter/non-digit boundary (handles
          // multi-word queries like "DevOps automation" and punctuation
          // like "DevOps." or "self-hosted"). Each token must be a
          // substring of at least one <mark> for the result to count.
          const tokens = rawQuery
            .toLowerCase()
            .split(/[^\p{L}\p{N}]+/u)
            .filter(t => t.length > 0);
          if (tokens.length === 0) return;

          const results = document.querySelectorAll<HTMLElement>(
            ".pagefind-ui__result"
          );
          let visible = 0;
          for (const result of results) {
            const markTexts = Array.from(result.querySelectorAll("mark"))
              .map(m => (m.textContent ?? "").toLowerCase())
              .filter(t => t.length > 0);
            const matched = tokens.every(token =>
              markTexts.some(mark => mark.includes(token))
            );
            result.style.display = matched ? "" : "none";
            if (matched) visible++;
          }

          // Patch the count message only when pagefind has rendered results.
          const msg = document.querySelector(".pagefind-ui__message");
          if (msg && results.length > 0) {
            const q = (inputEl?.value ?? "").trim();
            const want =
              visible === 0
                ? `No results for "${q}".`
                : visible === 1
                  ? `1 result for "${q}".`
                  : `${visible} results for "${q}".`;
            if (msg.textContent !== want) msg.textContent = want;
          }
        } finally {
          // childList only — we don't want characterData here because our own
          // textContent write to the message element would re-fire the loop.
          filterObserver.observe(pageFindSearch as HTMLElement, {
            childList: true,
            subtree: true,
          });
        }
      }

      const filterObserver = new MutationObserver(scheduleFilter);
      filterObserver.observe(pageFindSearch as HTMLElement, {
        childList: true,
        subtree: true,
      });

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
      }

      // Reset search param if search input is cleared + auto-focus on load.
      const searchInput = document.querySelector(
        ".pagefind-ui__search-input"
      ) as HTMLInputElement | null;
      const clearButton = document.querySelector(".pagefind-ui__search-clear");

      if (searchInput) {
        searchInput.placeholder = "Search posts, e.g. 'DevOps automation'";
        // Defer focus until after Pagefind's own setup pass.
        setTimeout(() => searchInput.focus(), 50);
      }

      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--background);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--foreground);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border);
    }

    input:focus-visible {
      outline: 1px solid var(--accent);
    }

    .pagefind-ui__result-title a {
      color: var(--accent);
      outline-offset: 1px;
      outline-color: var(--accent);
      text-decoration-style: dashed;
      text-underline-offset: var(--underline-offset);
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
