---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const POSTS_PER_PAGE = 20;
const MONTH_LONG = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const all = await getCollection("posts");
const sorted = getSortedPosts(all);

// Group: year → month → posts (already date-sorted descending).
type Entry = (typeof sorted)[number];
const yearOrder: number[] = [];
const yearMap = new Map<number, Map<number, Entry[]>>();
for (const post of sorted) {
  const d = new Date(post.data.pubDatetime);
  const year = d.getFullYear();
  const month = d.getMonth();
  if (!yearMap.has(year)) {
    yearMap.set(year, new Map());
    yearOrder.push(year);
  }
  const months = yearMap.get(year)!;
  if (!months.has(month)) months.set(month, []);
  months.get(month)!.push(post);
}

const totalPosts = sorted.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / POSTS_PER_PAGE));

// Materialise a nested year → month → posts structure with stable global
// indexes so the client-side pager can still hide/show post chunks.
type YearBlock = {
  year: number;
  count: number;
  months: {
    month: number;
    count: number;
    posts: { post: Entry; index: number }[];
  }[];
};
const years: YearBlock[] = [];
{
  let i = 0;
  for (const year of yearOrder) {
    const months = yearMap.get(year)!;
    const block: YearBlock = {
      year,
      count: [...months.values()].reduce((n, arr) => n + arr.length, 0),
      months: [],
    };
    for (const month of [...months.keys()].sort((a, b) => b - a)) {
      const posts = months.get(month)!;
      block.months.push({
        month,
        count: posts.length,
        posts: posts.map(post => ({ post, index: i++ })),
      });
    }
    years.push(block);
  }
}
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.postsTitle}>
    <section
      id="posts-archive"
      data-total-posts={totalPosts}
      data-per-page={POSTS_PER_PAGE}
      class="not-prose"
    >
      {
        years.map(yearBlock => (
          <Fragment>
            <header
              class="year-group app-section-header"
              data-year={yearBlock.year}
            >
              <h2 class="app-h2">{yearBlock.year}</h2>
              <span class="app-meta tabular-nums">
                {yearBlock.count} post{yearBlock.count === 1 ? "" : "s"}
              </span>
            </header>
            {yearBlock.months.map(monthBlock => (
              <Fragment>
                <div
                  class="month-group mt-8 first-of-type:mt-4"
                  data-year={yearBlock.year}
                  data-month={monthBlock.month}
                >
                  <span class="app-pill">{MONTH_LONG[monthBlock.month]}</span>
                </div>
                <ul>
                  {monthBlock.posts.map(({ post, index }) => (
                    <Card {...post} index={index} variant="h3" />
                  ))}
                </ul>
              </Fragment>
            ))}
          </Fragment>
        ))
      }
    </section>

    {
      totalPages > 1 && (
        <nav
          id="posts-pager"
          class="border-border mt-10 flex items-center justify-between border-t pt-6"
          aria-label="Posts pagination"
          data-total-pages={totalPages}
          hidden
        >
          <button
            type="button"
            id="pager-prev"
            class="app-btn"
            aria-label="Previous page"
          >
            ← Previous
          </button>

          <span class="app-meta tabular-nums" aria-live="polite">
            Page <span id="pager-current">1</span> of{" "}
            <span id="pager-total">{totalPages}</span>
          </span>

          <button
            type="button"
            id="pager-next"
            class="app-btn"
            aria-label="Next page"
          >
            Next →
          </button>
        </nav>
      )
    }
  </Main>

  <Footer />
</Layout>

<script>
  function initPostsPager() {
    const archive = document.getElementById("posts-archive");
    const pager = document.getElementById("posts-pager");
    if (!archive) return;

    const perPage = parseInt(archive.dataset.perPage ?? "20", 10);
    const totalPosts = parseInt(archive.dataset.totalPosts ?? "0", 10);
    const totalPages = Math.max(1, Math.ceil(totalPosts / perPage));

    // No pagination needed if everything fits on one page.
    if (totalPages <= 1 || !pager) return;

    pager.hidden = false;

    const prevBtn = document.getElementById(
      "pager-prev"
    ) as HTMLButtonElement | null;
    const nextBtn = document.getElementById(
      "pager-next"
    ) as HTMLButtonElement | null;
    const currentLabel = document.getElementById("pager-current");
    if (!prevBtn || !nextBtn || !currentLabel) return;

    const postRows = archive.querySelectorAll<HTMLElement>("[data-post-idx]");
    const monthGroups = archive.querySelectorAll<HTMLElement>(".month-group");
    const yearGroups = archive.querySelectorAll<HTMLElement>(".year-group");

    // Map year-key/month-key → header element so we can hide a header when no
    // post under it is visible on the current page.
    const yearByKey = new Map<string, HTMLElement>();
    yearGroups.forEach(h => {
      const key = h.dataset.year ?? "";
      if (key) yearByKey.set(key, h);
    });
    const monthByKey = new Map<string, HTMLElement>();
    monthGroups.forEach(h => {
      const y = h.dataset.year ?? "";
      const m = h.dataset.month ?? "";
      if (y && m) monthByKey.set(`${y}:${m}`, h);
    });

    // Each <ul> holds the posts for one month. Hide a <ul> when all its <li>s
    // are on a different page.
    const monthLists = archive.querySelectorAll<HTMLUListElement>(
      "ul:has(> [data-post-idx])"
    );

    function showPage(page: number) {
      const p = Math.max(1, Math.min(totalPages, page));
      const start = (p - 1) * perPage;
      const end = start + perPage;

      const yearsWithVisible = new Set<string>();
      const monthsWithVisible = new Set<string>();

      postRows.forEach(row => {
        const idx = parseInt(row.dataset.postIdx ?? "-1", 10);
        const visible = idx >= start && idx < end;
        row.hidden = !visible;
        if (!visible) return;
        // The row is inside a <ul>; year/month headers are siblings of that <ul>.
        const ul = row.parentElement;
        let sib: Element | null = ul?.previousElementSibling ?? null;
        let monthEl: HTMLElement | null = null;
        let yearEl: HTMLElement | null = null;
        while (sib) {
          if (!monthEl && sib.classList.contains("month-group"))
            monthEl = sib as HTMLElement;
          if (sib.classList.contains("year-group")) {
            yearEl = sib as HTMLElement;
            break;
          }
          sib = sib.previousElementSibling;
        }
        if (yearEl?.dataset.year) yearsWithVisible.add(yearEl.dataset.year);
        if (monthEl?.dataset.year && monthEl?.dataset.month) {
          monthsWithVisible.add(
            `${monthEl.dataset.year}:${monthEl.dataset.month}`
          );
        }
      });

      // Hide empty <ul> wrappers (no visible <li> children).
      monthLists.forEach(ul => {
        const anyVisible = [
          ...ul.querySelectorAll<HTMLElement>("[data-post-idx]"),
        ].some(li => !li.hidden);
        ul.hidden = !anyVisible;
      });

      yearByKey.forEach((el, k) => {
        el.hidden = !yearsWithVisible.has(k);
      });
      monthByKey.forEach((el, k) => {
        el.hidden = !monthsWithVisible.has(k);
      });

      currentLabel!.textContent = String(p);
      prevBtn!.disabled = p <= 1;
      nextBtn!.disabled = p >= totalPages;

      // URL sync.
      const url = new URL(window.location.href);
      if (p === 1) url.searchParams.delete("page");
      else url.searchParams.set("page", String(p));
      window.history.replaceState(null, "", url.toString());
    }

    function gotoPageFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const p = parseInt(params.get("page") ?? "1", 10);
      showPage(Number.isFinite(p) ? p : 1);
    }

    prevBtn.addEventListener("click", () => {
      const current = parseInt(currentLabel.textContent ?? "1", 10);
      showPage(current - 1);
      archive.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    nextBtn.addEventListener("click", () => {
      const current = parseInt(currentLabel.textContent ?? "1", 10);
      showPage(current + 1);
      archive.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    gotoPageFromUrl();
  }

  initPostsPager();
  document.addEventListener("astro:after-swap", initPostsPager);
</script>
