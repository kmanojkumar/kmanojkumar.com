---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getRenderablePosts, getSortedPosts } from "@/utils/getSortedPosts";
import { getReadingStats } from "@/utils/readingTime";
import { slugifyStr } from "@/utils/slugify";
import Topic from "@/components/Topic.astro";
import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import config from "@/config";

export async function getStaticPaths() {
  const all = await getCollection("posts");
  // Render every non-draft, in-window post (including unlisted ones — they have
  // a page reachable by direct link). prev/next adjacency comes from the
  // listed posts only, so unlisted posts have no adjacent nav.
  const renderable = getRenderablePosts(all);
  const listed = getSortedPosts(all);

  const adjacent = (p: (typeof listed)[number] | undefined) =>
    p ? { id: p.id, title: p.data.title, filePath: p.filePath } : null;

  return renderable.map(post => {
    const i = listed.findIndex(p => p.id === post.id);
    return {
      params: { slug: getPostSlug(post.id, post.filePath) },
      props: {
        post,
        prevPost: i > 0 ? adjacent(listed[i - 1]) : null,
        nextPost:
          i >= 0 && i < listed.length - 1 ? adjacent(listed[i + 1]) : null,
      },
    };
  });
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  topics,
  hideEditPost,
} = post.data;

const { Content } = await render(post);
const reading = getReadingStats(post.body);

// Hero image shown below the metadata line, above the article body.
// Prefer explicit `heroImage`; fall back to the OG cover image (which every
// post already has). Only render if it's an Astro-processed image asset.
const heroSource = post.data.heroImage ?? post.data.ogImage;
const hero = heroSource && typeof heroSource !== "string" ? heroSource : null;

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  author={post.data.author}
  topics={topics}
  wordCount={reading.words}
  timeRequired={reading.iso}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={[
      "app-layout pb-4",
      // Match Main.astro top spacing (48px, consistent with section-header mt-12).
      // When BackButton is shown, it owns the top spacing instead.
      { "pt-12": !config.features.showBackButton },
    ]}
    {...post.data.unlisted
      ? { "data-pagefind-ignore": "all" }
      : { "data-pagefind-body": "" }}
  >
    <h1
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="app-h1 text-accent inline-block"
    >
      {title}
    </h1>

    <div class="mt-2 mb-3 flex flex-wrap items-center gap-x-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} showIcon={false} />
      <span aria-hidden="true" class="text-muted-foreground">·</span>
      <span class="app-meta">{reading.text}</span>
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        ·
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    {
      hero && (
        <figure class="my-6 aspect-video w-full overflow-hidden rounded-lg">
          <Image
            src={hero}
            alt=""
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 768px) 768px, 100vw"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </figure>
      )
    }

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <p
      class="text-muted-foreground mt-8 font-mono text-sm"
      aria-label="end of article"
    >
      MK <span aria-hidden="true" class="cursor-blink">▌</span>
    </p>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ul class="mt-4 mb-8 flex flex-wrap gap-4 sm:my-8">
      {
        topics.map(name => (
          <Topic slug={slugifyStr(name)} name={name} size="sm" />
        ))
      }
    </ul>

    <ShareLinks
      title={title}
      url={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
    />

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>

<script is:inline data-astro-rerun>
  // Top rail state: number of `▮▯` cells is recomputed from the container's
  // actual rendered width so the bar fills the column regardless of viewport.
  // Minimum floor of 20 cells so the bar still feels meaningful on tiny widths.
  let cellCount = 40;
  let fillRatio = 0;

  function measureCellWidth(bar) {
    const probe = document.createElement("span");
    probe.textContent = "▮";
    const s = getComputedStyle(bar);
    probe.style.font = s.font;
    probe.style.letterSpacing = s.letterSpacing;
    probe.style.position = "absolute";
    probe.style.visibility = "hidden";
    probe.style.whiteSpace = "pre";
    document.body.appendChild(probe);
    const w = probe.getBoundingClientRect().width;
    document.body.removeChild(probe);
    return w;
  }

  function recomputeCellCount() {
    const bar = document.getElementById("myBar");
    if (!bar || !bar.parentElement) return;
    // The bar's immediate parent (.progress-inner) is the rendered content
    // column — its clientWidth already excludes the outer's px-4 gutter and
    // is the exact horizontal space the row of ▮▯ has available.
    const available = bar.parentElement.clientWidth;
    const cellWidth = measureCellWidth(bar);
    if (cellWidth <= 0) return;
    cellCount = Math.max(20, Math.floor(available / cellWidth));
    renderBar();
  }

  function renderBar() {
    const bar = document.getElementById("myBar");
    if (!bar) return;
    const filled = Math.round(fillRatio * cellCount);
    bar.textContent =
      "▮".repeat(filled) + "▯".repeat(Math.max(0, cellCount - filled));
  }

  function createProgressBar() {
    // Mirrors Header.astro's two-element pattern so the rail's border line
    // matches the header's border line EXACTLY:
    //   outer = app-layout       (max-w-3xl + mx-auto + w-full + px-4)
    //   inner = w-full + bg + border-b + padding
    // border-b sits on the inner, so it spans the column's content width
    // (max-w-3xl − 2 × px-4), same as the header's border.
    const outer = document.createElement("div");
    outer.className = "progress-container app-layout sticky top-0 z-20";

    const inner = document.createElement("div");
    inner.className =
      "progress-inner border-border bg-background relative w-full border-b py-1 text-center font-mono text-xs tabular-nums tracking-tight whitespace-nowrap overflow-hidden";

    const progressBar = document.createElement("span");
    progressBar.id = "myBar";
    progressBar.className = "text-foreground/45";

    inner.appendChild(progressBar);
    outer.appendChild(inner);
    document.body.insertBefore(outer, document.body.firstChild);

    recomputeCellCount();
    window.addEventListener("resize", recomputeCellCount);
  }
  createProgressBar();

  function updateScrollProgress() {
    let ticking = false;
    document.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        const winScroll =
          document.body.scrollTop || document.documentElement.scrollTop;
        const height =
          document.documentElement.scrollHeight -
          document.documentElement.clientHeight;
        const ratio = height > 0 ? winScroll / height : 0;
        fillRatio = Math.max(0, Math.min(1, ratio));
        renderBar();
        ticking = false;
      });
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    const headings = Array.from(
      document.querySelectorAll("h2, h3, h4, h5, h6")
    );
    for (const heading of headings) {
      heading.classList.add("group", "lg:relative");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100 lg:absolute lg:top-0 lg:-left-7 lg:w-7 lg:ms-0 lg:text-center lg:text-muted-foreground";
      link.href = "#" + heading.id;

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      button.innerText = "Copied";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
