---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Topic from "@/components/Topic.astro";
import { getUniqueTopics } from "@/utils/getUniqueTopics";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const topics = getUniqueTopics(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.topicsTitle} | ${config.site.title}`}>
  <Header />

  <Main pageTitle={t.pages.topicsTitle}>
    <ul class="flex flex-wrap gap-6">
      {topics.map(({ slug, name }) => <Topic {slug} {name} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
